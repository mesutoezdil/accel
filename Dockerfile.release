# Used by goreleaser: the binary is already built for the target platform.
FROM alpine:3.20
# gcompat: NVML's glibc .so has no glibc dynamic loader on musl otherwise.
# The binary sits at / so a host /usr mounted over the container's /usr
# (for vendor libraries and CLIs) cannot hide it.
RUN apk add --no-cache gcompat
COPY accel /accel
ENTRYPOINT ["/accel"]
CMD ["--service", "--listen", ":9800", "--insecure"]
